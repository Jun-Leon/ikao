# ikao 后端配置示例
# 复制为 .env 后按需修改；所有变量前缀为 IKAO_

# 打包版监听端口（被占用时会自动向后探测）
# IKAO_PORT=8010

# 应用名与版本（显示在顶栏与首页）
# IKAO_APP_NAME=ikao
# IKAO_VERSION=1.0

# 数据目录（SQLite 库与导入数据）
# IKAO_DATA_DIR=data

# 自定义数据库连接串；留空则使用 data/ikao.db
# IKAO_DATABASE_URL=

# 导入去重相似度阈值（0~1，越大越严格）
# IKAO_DEDUP_THRESHOLD=0.90

# 单次导入允许的最大题目数
# IKAO_MAX_IMPORT_QUESTIONS=20000
